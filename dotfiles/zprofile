# Login shells: environment variables and PATH. Interactive settings go in zshrc.

eval "$($BREW_HOME/bin/brew shellenv)"

export PYENV_ROOT="$HOME/.pyenv"
export BUN_INSTALL="$HOME/.bun"
export PROTO_HOME="$HOME/.proto"
export locize_INSTALL="$HOME/.locize-cli"

# PATH, highest priority first; folders that don't exist on this machine are dropped below
path=(
    $PROTO_HOME/shims $PROTO_HOME/bin
    $PYENV_ROOT/shims $PYENV_ROOT/bin
    $BUN_INSTALL/bin
    $locize_INSTALL/bin
    $HOMEBREW_PREFIX/opt/lsof/bin       # Linux-compatible lsof
    $HOMEBREW_PREFIX/opt/openjdk/bin
    $HOMEBREW_PREFIX/opt/curl/bin
    $HOME/opt/bin
    $HOME/.local/bin
    $HOME/opt/gnubin
    $path
    $SYSTEM_PYTHON_INSTALL_PATH
    $HOME/.rvm/bin
    "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
    /Applications/Obsidian.app/Contents/MacOS
    $HOME/.lmstudio/bin
)

# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

path=($^path(N-/))

export MANPATH="$HOME/opt/gnuman:$HOMEBREW_PREFIX/man${MANPATH+:$MANPATH}"
export LIBRARY_PATH="$HOMEBREW_PREFIX/lib${LIBRARY_PATH+:$LIBRARY_PATH}"

export AWS_FUZZ_USER="csaba.palankai"
export AWS_FUZZ_PRIVATE_IP='True'
export AWS_MIN_TTL=72000
export AWS_VAULT_PROMPT=osascript
export AWS_VAULT_KEYCHAIN_NAME=login

export EDITOR=vim
export PAGER=less
export LESS=-R
export LESS_TERMCAP_md=$'\E[01;36m'


if [ -f $WORKSTATION_INSTALLATION_PATH/sensitive/targets/$WORKSTATION/dotfiles/zprofile ]; then
    source $WORKSTATION_INSTALLATION_PATH/sensitive/targets/$WORKSTATION/dotfiles/zprofile
fi

if [ -f ~/.zprofile_local ]; then
      source ~/.zprofile_local
fi
