#!/bin/sh
# Workstation manager from anywhere; symlink into ~/.local/bin
manager="$(cd "$(dirname "$(readlink -f "$0")")/../manager" && pwd)"
extra=""
[ "$1" = serve ] && extra="--extra server"
for arg; do [ "$arg" = --open ] && extra="--extra server"; done
exec uv run --quiet --no-dev $extra --project "$manager" workstation-manager "$@"
